class Drawing {
	field int x;
	field int y;
	field int ROWS;
	field int COLUMNS;
	field int PADDING;
	
	constructor Drawing new(){
		do Output.printString("start drawing");
		do Output.println();
		let ROWS=216;
		let COLUMNS=472;
		let PADDING=20;
		return this;
	}

method void drawSelectedCells(Array cellMemory){

	var int i;
	var int stepX;
	var int stepY;

	let stepX = (COLUMNS/6);
	let stepY = (ROWS/6);
	let i = 0;
	while(i < 9){

		if(cellMemory[i] = 0){

			if(i = 0){
				do Screen.drawCircle(PADDING+stepX,PADDING+stepY,10);
			}
			if(i = 1){
				do Screen.drawCircle(PADDING+(3*stepX),PADDING+stepY,10);
			}
			if(i = 2){
				do Screen.drawCircle(PADDING+(5*stepX),PADDING+stepY,10);
			}
			if(i = 3){
				do Screen.drawCircle(PADDING+stepX,PADDING+(3*stepY),10);
			}
			if(i = 4){
				do Screen.drawCircle(PADDING+(3*stepX),PADDING+(3*stepY),10);
			}
			if(i = 5){
				do Screen.drawCircle(PADDING+(5*stepX),PADDING+(3*stepY),10);
			}
			if(i = 6){
				do Screen.drawCircle(PADDING+stepX,PADDING+(5*stepY),10);
			}
			if(i = 7){
				do Screen.drawCircle(PADDING+(3*stepX),PADDING+(5*stepY),10);
			}
			if(i = 8){
				do Screen.drawCircle(PADDING+(3*stepX),PADDING+(5*stepY),10);
			}
		}else{
			//if(i = 0){
			//	do Screen.drawRectangle(PADDING+stepX,PADDING+stepY,15);
			//}
			//if(i = 1){
			//	do Screen.drawRectangle(PADDING+(3*stepX),PADDING+stepY,15);
			//}
			//if(i = 2){
			//	do Screen.drawRectangle(PADDING+(5*stepX),PADDING+stepY,15);
			//}
//			if(i = 3){
//				do Screen.drawRectangle(PADDING+stepX,PADDING+stepY,20);
//			}
//			if(i = 4){
//				do Screen.drawRectangle(PADDING+(3*stepX),PADDING+stepY,20);
//			}
//			if(i = 5){
//				do Screen.drawRectangle(PADDING+(5*stepX),PADDING+stepY,20);
//			}
//			if(i = 6){
//				do Screen.drawRectangle(PADDING+stepX,PADDING+stepY,20);
//			}
//			if(i = 7){
//				do Screen.drawRectangle(PADDING+(3*stepX),PADDING+stepY,20);
//			}
//			if(i = 8){
//				do Screen.drawRectangle(PADDING+(3*stepX),PADDING+stepY,20);
//			}

		}
		let i = i + 1 ;
	}
	return;
}

method void drawBoard(Array cellMemory){
	var Drawing drawing ;
	var int rows;
	var int cols;
	var int padding;
	var int i;

	let drawing = this;

	let rows = drawing.getRows();
	let cols = drawing.getColumns();
	let padding = drawing.getPadding();

	let i = 0;
	while(i < 9){
    do Output.printInt(i);
		do Output.printString(" -> ");
    do Output.printInt(cellMemory[i]);
	  do Output.println();
		let i = i + 1 ;
	}

	

	//do Screen.setColor(true);

	////do Output.printString("Testing");
	////do Output.println();


	
	do Screen.drawLine(cols/3,padding,cols/3,(rows - padding));
	do Screen.drawLine(cols*2/3,padding,cols*2/3,(rows - padding));
	do Screen.drawLine(padding,rows/3,cols-padding,rows/3);
	do Screen.drawLine(padding,rows*2/3,cols-padding,rows*2/3);
	//do Screen.drawLine(100,100+100,100+100,100+100);
	//do Screen.drawCircle((cols/6)+padding,(rows/6)+padding,20);

	do drawing.drawSelectedCells(cellMemory);
	return;
}


method int getColumns(){
	return COLUMNS;
}
method int getRows(){
	return ROWS;
}
method int getPadding(){
	return PADDING;
}

method void clearScreen(){
	do Screen.clearScreen();
	return;
}

method void drawSprite(int spriteP, int cell){
	return ;
