class Drawing {
	field int x;
	field int y;
	field int ROWS;
	field int COLUMNS;
	field int PADDING;
	field int SUBPADDING;
	
	constructor Drawing new(){
		do Output.printString("start drawing");
		do Output.println();
		let ROWS=216;
		let COLUMNS=472;
		let PADDING=20;
		let SUBPADDING=15;
		return this;
	}

method void drawSelectedCells(Array cellMemory){

	var int i;
	var int stepXCircle;
	var int stepYCircle;
	
	var int stepXRectangle;
	var int stepYRectangle;


	let stepXCircle = (COLUMNS/6);
	let stepYCircle = (ROWS/6);

	let i = 0;


														

	while(i < 9){

		if(cellMemory[i] = 0){

			if(i = 0){
				do Screen.drawCircle(PADDING+stepXCircle,PADDING+stepYCircle,18);
			}
			if(i = 1){
				do Screen.drawCircle(PADDING+(3*stepXCircle),PADDING+stepYCircle,18);
			}
			if(i = 2){
				do Screen.drawCircle(PADDING+(5*stepXCircle),PADDING+stepYCircle,18);
			}
			if(i = 3){
				do Screen.drawCircle(PADDING+stepXCircle,PADDING+(3*stepYCircle),18);
			}
			if(i = 4){
				do Screen.drawCircle(PADDING+(3*stepXCircle),PADDING+(3*stepYCircle),18);
			}
			if(i = 5){
				do Screen.drawCircle(PADDING+(5*stepXCircle),PADDING+(3*stepYCircle),18);
			}
			if(i = 6){
				do Screen.drawCircle(PADDING+stepXCircle,PADDING+(5*stepYCircle),18);
			}
			if(i = 7){
				do Screen.drawCircle(PADDING+(3*stepXCircle),PADDING+(5*stepYCircle),18);
			}
			if(i = 8){
				do Screen.drawCircle(PADDING+(5*stepXCircle),PADDING+(5*stepYCircle),18);
			}
		}
		if(cellMemory[i] = 1){
			if(i = 0){
					do Screen.drawRectangle(PADDING+(4*SUBPADDING),PADDING+SUBPADDING,PADDING+(COLUMNS/3)-(4*SUBPADDING),PADDING+(ROWS/3)-SUBPADDING);
			}
			if(i = 1){
					do Screen.drawRectangle(PADDING+(COLUMNS/3)+(4*SUBPADDING),PADDING+SUBPADDING,PADDING+(2*COLUMNS/3)-(4*SUBPADDING),PADDING+(ROWS/3)-SUBPADDING);
			}
			if(i = 2){
					do Screen.drawRectangle(PADDING+(2*COLUMNS/3)+(4*SUBPADDING),PADDING+SUBPADDING,PADDING+(3*COLUMNS/3)-(4*SUBPADDING),PADDING+(ROWS/3)-SUBPADDING);
			}
			if(i = 3){
						do Screen.drawRectangle(PADDING+(4*SUBPADDING),PADDING+(ROWS/3)+SUBPADDING,PADDING+(COLUMNS/3)-(4*SUBPADDING),PADDING+(2*ROWS/3)-SUBPADDING);
			}
			if(i = 4){
						do Screen.drawRectangle(PADDING+(COLUMNS/3)+(4*SUBPADDING),PADDING+(ROWS/3)+SUBPADDING,PADDING+(2*COLUMNS/3)-(4*SUBPADDING),PADDING+(2*ROWS/3)-SUBPADDING);
			}
			if(i = 5){
						do Screen.drawRectangle(PADDING+(2*COLUMNS/3)+(4*SUBPADDING),PADDING+(ROWS/3)+SUBPADDING,PADDING+(3*COLUMNS/3)-(4*SUBPADDING),PADDING+(2*ROWS/3)-SUBPADDING);
			}
			if(i = 6){
		do Screen.drawRectangle(PADDING+(4*SUBPADDING),PADDING+(2*ROWS/3)+SUBPADDING,PADDING+(COLUMNS/3)-(4*SUBPADDING),PADDING+(3*ROWS/3)-SUBPADDING);
			}
			if(i = 7){
		do Screen.drawRectangle(PADDING+(COLUMNS/3)+(4*SUBPADDING),PADDING+(2*ROWS/3)+SUBPADDING,PADDING+(2*COLUMNS/3)-(4*SUBPADDING),PADDING+(3*ROWS/3)-SUBPADDING);
			}
			if(i = 8){
		do Screen.drawRectangle(PADDING+(2*COLUMNS/3)+(4*SUBPADDING),PADDING+(2*ROWS/3)+SUBPADDING,PADDING+(3*COLUMNS/3)-(4*SUBPADDING),PADDING+(3*ROWS/3)-SUBPADDING);
			}
	}
		let i = i + 1 ;
	}
	return;
}

method void drawBoard(Array cellMemory){
	var Drawing drawing ;
	var int rows;
	var int cols;
	var int padding;
	var int i;

	let drawing = this;

	let rows = drawing.getRows();
	let cols = drawing.getColumns();
	let padding = drawing.getPadding();

	
	do Screen.drawLine(padding+(cols/3),padding,padding+(cols/3),(rows - padding));
	do Screen.drawLine(padding+(cols*2/3),padding,padding+(cols*2/3),(rows - padding));
	do Screen.drawLine(padding,padding+(rows/3),(cols-padding),padding+(rows/3));
	do Screen.drawLine(padding,padding+(rows*2/3),(cols-padding),padding+(rows*2/3));

	do drawing.drawSelectedCells(cellMemory);
	return;
}


method int getColumns(){
	return COLUMNS;
}
method int getRows(){
	return ROWS;
}
method int getPadding(){
	return PADDING;
}

method void clearScreen(){
	do Screen.clearScreen();
	return;
}

method void dispose(){
	do Memory.deAlloc(this);
	return;
}

}
