class TicTacToe {

	field Array players;
	field int numberPlayers;
	field int registerPlayers;
	field Drawing drawing;
	field Array cellMemory;
	field int turnFlag;
	field int winnerPoints;
	field int tiePoints;
	field int numberOfMatches;
	field String instructions;
	/*
	 * winner == -1 --> not winner yet
	 * winner == 0  --> player 1 won
	 * winner == 1  --> player 2 won
	 * winner == 2  --> draw
	*/
	field int winner;

	constructor TicTacToe new(){

    do Output.printString("Tic Tac Toe");
		do Output.println();

		let numberPlayers = 2;
		let registerPlayers = 0;
		let numberOfMatches = 0;
		let instructions = String.new(120);
		let instructions = "The idea is simple is 3x3 matrix from left to right and from up to down, first position is 0 and last one is 8.";

		let winner = -1;
		let players = Array.new(numberPlayers);
		let cellMemory = Array.new(9);


		do createDrawing();

		do createPlayer();
		do createPlayer();

		do initTurnFlag();

		do initialiseCellMemory();

		return this;
	}

method void initialiseCellMemory(){

	var int i;
	let i = 0;

	while( i < 9  ){
		let cellMemory[i] = -1;
		let i = i + 1;
	}
	return;
}

method void showCellMemory(){

	var int i;
	let i = 0;

	while( i < 9  ){
		do Output.printString("i->");
		do Output.printInt(i);
		do Output.println();
		do Output.printInt(cellMemory[i]);
		let i = i + 1;
	}
	return;
}

method void initTurnFlag(){
	let turnFlag = 0;
	return;
}
method void createPlayer(){

		var String name;

		do Output.println();
		do Output.printString("create new player");

		if(registerPlayers < numberPlayers  ){

			let name = String.new(30);
			let name = Keyboard.readLine("Register name:");

			//do Output.println();
			//do Output.printString("Inside register");

			let players[registerPlayers] = Player.new(name,0,registerPlayers);
			let registerPlayers = registerPlayers+1;

		}
	//	do Output.println();
	//	do Output.printString("Outside register");
		return;

}

method bool gameEnded(){
	var bool result;
	var int continue;

	let result = false;

	do Output.println();
	let continue = Keyboard.readInt("0 -> stop playing || 1 -> continue playing:  ");
	do Output.println();

	if(continue = 0){
		let result = true;
	}
	if(continue = 1 ){
		let result = false;
	}
	return result;
}
