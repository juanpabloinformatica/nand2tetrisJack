method void showPickableCells(){
	
	var int i;
	let i = 0;
	while(i < 9){
		if(cellMemory[i]=-1){
			do Output.printInt(i);
			if(~(i=9)){
				do Output.printString("->");
			}
		}
		let i=i+1;
	}
	do Output.println();
	return;
}

method void pickCell(){
	var TicTacToe ticTacToe;
	var int i;
	var int cell;
	var Player player0;
	var Player player1;

	let player0 =  getPlayer1();
	let player1 =  getPlayer2();

	let ticTacToe = this;
	//let cellMemory = ticTacToe.getCellMemory();
	let i = 0;



	do Output.println();
	do Output.printString("The player: ");
	if(turnFlag = 0){
		do Output.printString(player0.getName());
	}else{
		do Output.printString(player1.getName());
	}
	do Output.println();
	do Output.printString("You can pick the following cells.");
	do Output.println();

	do showPickableCells();
	do Output.println();
	let cell = Keyboard.readInt("Choose cell: ");
	
	while(~(cellMemory[cell] = -1)){
		do Output.printString("cell:");
		do Output.printInt(cell);
		do Output.println();
		do Output.printString("Already selected you can pick");
		do Output.println();
		do showPickableCells();
		let cell = Keyboard.readInt("Choose cell: ");
	}

	let cellMemory[cell] = turnFlag;
	
	do showCellMemory();

	return;
}

method void showInstructions(){
	var int continue;
	do Output.println();
	do Output.printString(instructions);
	do Output.println();
	let continue = 0;
	while(continue=0){
		let continue= Keyboard.keyPressed();
	}
	return;
}
method void startGame(){

	var TicTacToe ticTacToe;
	var Drawing drawing;
	var Array cellMemory;
	var bool continueGame;
	var bool continueMatch;

	let ticTacToe = this;
	let drawing = ticTacToe.getDrawing();
	let cellMemory = ticTacToe.getCellMemory();
	let continueGame = false;
	let continueMatch = false;
	

	while(~(continueGame = true)){
		do resetMatch();
		if(numberOfMatches < 1){
			do showInstructions();
		}
		while(~(continueMatch = true)){
			do drawing.clearScreen();
			do ticTacToe.pickCell();
			do drawing.clearScreen();
			do drawing.drawBoard(cellMemory);
			do Sys.wait(3000);
			let continueMatch = ticTacToe.matchEnded();
			do switchTurnFlag();
		}
		let numberOfMatches = numberOfMatches+1;
		do drawing.clearScreen();
		do updatePlayersPoints();
		do showMatchWinner();
		let continueGame =  gameEnded();
	}
	do showGameWinner();
	return;
}


method void resetMatch(){
	/*reset cells for redrawing*/
	var int i;
	let i = 0;
	while (i < 9){
		let cellMemory[i] = -1;
		let i = i + 1;
	}
	let winner = -1;
	return;
}
method void updatePlayersPoints(){
	var Player player0,player1;
	let player0 =  players[0];
	let player1 =  players[1];

	if(winner = 0){
		do player0.setPoints(3);
	}
	if(winner = 1){
		do player1.setPoints(3);
	}
	if(winner = 2){
		do player0.setPoints(1);
		do player1.setPoints(1);
	}
	return;
}

method void showGameWinner(){

	var Player player0;
	var Player player1;

	let player0 =  getPlayer1();
	let player1 =  getPlayer2();

	do Output.printString("Winner of game:");
	do Output.println();


	if(player0.getPoints() > player1.getPoints()){
	do Output.printString("Winner:");
	do Output.println();
	do Output.printString(player0.getName());
	}
	if(player0.getPoints() < player1.getPoints()){
	do Output.printString("Winner:");
	do Output.println();
	do Output.printString(player1.getName());
	}
	if (player0.getPoints() = player1.getPoints()){
	do Output.printString("No Winner, is a Game TIE");
	do Output.println();
	}

	return;
}
method void showMatchWinner(){
	var Player player0;
	var Player player1;

	let player0 =  getPlayer1();
	let player1 =  getPlayer2();

	do Output.printString("Winner of match: ");
	do Output.printInt(numberOfMatches);
	do Output.println();

	if(winner = 0){
	do Output.printString("Winner:");
	do Output.println();
	do Output.printString(player0.getName());
	}
	if(winner = 1){
	do Output.printString("Winner:");
	do Output.println();
	do Output.printString(player1.getName());
	}
	if (winner = 2){
	do Output.printString("No Winner, is a match TIE");
	do Output.println();
	}

	return;
}


method void createDrawing(){
	let drawing = Drawing.new();
	return;
}



method Player getPlayer1(){
	return players[0];
}
method Player getPlayer2(){
	return players[1];
}
method Drawing getDrawing(){
	return drawing;

}
method Array getCellMemory(){
	return cellMemory;
}
method int getTurnFlag(){
	return turnFlag;

}
method void switchTurnFlag(){
	if(turnFlag = 0){
		let turnFlag = 1;
	}else{
		let turnFlag = 0;
	}
	return;
}
method void setTurnFlag(){
	let turnFlag = winner;
	return;
}

}
